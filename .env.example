# ---------- OAuth mode (recommended; default when GITHUB_CLIENT_ID is set) ----------
# 1. GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#    Homepage URL:      https://YOUR-SERVICE.onrender.com
#    Callback URL:      https://YOUR-SERVICE.onrender.com/github/callback
# 2. Generate a client secret and copy both values here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your public https URL, no trailing slash.
PUBLIC_URL=https://YOUR-SERVICE.onrender.com

# 32 random bytes, base64. Encrypts every token. Generate: openssl rand -base64 32
# Changing it logs everyone out (all existing tokens stop working).
ENCRYPTION_KEY=

# Comma separated GitHub logins that may sign in. Everyone else is refused.
ALLOWED_GITHUB_USERS=your-github-login

# Optional
# GITHUB_SCOPES=repo workflow delete_repo admin:repo_hook read:org gist
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=2592000

# ---------- Guardrails ----------
# Default is FULL_CONTROL=true: every repo, every write, deletes without confirmation.
# Set false to enable the guardrails below.
FULL_CONTROL=true
# ALLOWED_REPOS=your-login/*
# READ_ONLY=false
# ENABLE_DESTRUCTIVE=false

# ---------- Static mode (local dev only) ----------
# AUTH_MODE=static
# GITHUB_TOKEN=github_pat_...
# MCP_SECRET=      # openssl rand -hex 32 ; connector URL becomes /mcp/<MCP_SECRET>
