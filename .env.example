# Fine-grained PAT (or classic token) with whatever access you want Claude to have.
# For true full control incl. repo settings, protection and delete: Administration RW too.
GITHUB_TOKEN=github_pat_xxxxxxxx

# Long random string (generate: openssl rand -hex 32). It becomes part of the connector URL.
MCP_SECRET=change-me-to-a-long-random-string

# Default is FULL_CONTROL (no allowlist, no read-only, no confirmations).
# Set FULL_CONTROL=false to bring guardrails back and use the settings below.
FULL_CONTROL=true
# ALLOWED_REPOS=Zohaib8090/*
# READ_ONLY=false
# ENABLE_DESTRUCTIVE=false
