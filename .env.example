# Fine-grained PAT limited to the repos you want. Permissions: Contents RW, Pull requests RW,
# Actions RW, Metadata R, Webhooks RW, Pages RW, Administration R (add W only if you need repo settings/protection/delete).
GITHUB_TOKEN=github_pat_xxxxxxxx

# Long random string (generate: openssl rand -hex 32). It becomes part of the connector URL.
MCP_SECRET=change-me-to-a-long-random-string

# Which repos this connector may touch. "owner/*" or a comma separated list.
ALLOWED_REPOS=Zohaib8090/*

# Guardrails
READ_ONLY=false
ENABLE_DESTRUCTIVE=false
